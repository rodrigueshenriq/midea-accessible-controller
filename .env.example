# Somente exemplos fictícios. Copie para .dev.vars (ignorado pelo Git).
# Cadastre os valores reais somente no ambiente privado do seu próprio projeto.
FIREBASE_PROJECT_ID="example-project"
FIREBASE_OWNER_UID="example-owner-uid"
FIREBASE_OWNER_EMAIL="owner@example.test"
FIREBASE_WEB_API_KEY="EXAMPLE_FIREBASE_WEB_API_KEY"
MIDEA_CREDENTIALS_JSON='{"account":"user@example.test","password":"EXAMPLE_PASSWORD","target":{"device_id":"EXAMPLE_DEVICE_ID","sn":"EXAMPLE_SERIAL"}}'
# Parâmetros privados do transporte: obtenha legitimamente para sua instalação.
# Os exemplos abaixo não conectam à nuvem Midea.
MIDEA_APP_KEY="EXAMPLE_APP_KEY"
MIDEA_IOT_KEY="EXAMPLE_IOT_KEY"
MIDEA_HMAC_KEY="EXAMPLE_HMAC_KEY"
MIDEA_FIXED_KEY="EXAMPLE_KEY_16BYT"
MIDEA_FIXED_IV="EXAMPLE_IV_16BYT_"
# Gere uma chave exclusiva de 32 bytes com o comando indicado no README.
STATE_KEY="EXAMPLE_STATE_KEY_NOT_VALID"
